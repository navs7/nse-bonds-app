# Copy to .env (git-ignored). Never commit real values.
UPSTOX_ACCESS_TOKEN=
# Seconds after which a live quote is flagged STALE
QUOTE_STALE_AFTER_SECONDS=300
BONDS_CSV=data/bonds.csv

# Daily Upstox login automation (python -m app.upstox_auth). Keep these ONLY in .env.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_MOBILE=
UPSTOX_PIN=
UPSTOX_TOTP_KEY=
# Must match the redirect URI registered for your Upstox app
UPSTOX_REDIRECT_URI=https://account.upstox.com/developer/apps
# false = visible browser window (more reliable); true = hidden
UPSTOX_LOGIN_HEADLESS=false
